{
  "name": "srb-nexus",
  "version": "1.0.0",
  "description": "SRB NEXUS Central Infrastructure & Security System",
  "main": "dist/index.js",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./src/styles/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -c ./tailwind.config.js -i ./src/styles/input.css -o ./public/styles.css --watch",
    "build": "npm run build:css && tsc && copyfiles -u 0 public/* dist/ && copyfiles -u 0 assets/**/* dist/",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy:commands": "node -e \"const { registerSlashCommands } = require('./dist/discord/commands/index.js'); require('dotenv').config(); registerSlashCommands(process.env.DISCORD_CLIENT_ID || '1526885301736177705');\"",
    "deploy:client-portal": "ts-node src/scripts/deployClientPortal.ts",
    "create:client": "ts-node src/scripts/createClientSpace.ts"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/static": "^10.1.3",
    "@napi-rs/canvas": "^1.0.6",
    "axios": "^1.19.0",
    "copyfiles": "^2.4.1",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^3.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.3",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.31.0",
    "mediaplex": "^1.0.0",
    "next": "^16.3.1",
    "opusscript": "^0.0.8",
    "pg": "^8.11.5",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "play-dl": "^1.9.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "simple-ytdl-core": "^1.1.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.3",
    "youtubei.js": "^18.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-router-dom": "^5.3.3",
    "tailwindcss": "^3.4.19",
    "ts-node-dev": "^2.0.0"
  }
}
