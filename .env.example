# ===============================================
# SRB NEXUS Configuration & Secrets Specification
# ===============================================

# Server Environment & Port
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# JWT Web Session Authentication
JWT_SECRET=super-secure-random-jwt-secret-key-replace-in-production

# PostgreSQL Database Connection URL
# Local Docker Postgres default: postgresql://nexus:nexuspassword@localhost:5432/srb_nexus
# Or Cloud PostgreSQL (Supabase / Neon / RDS):
DATABASE_URL=postgresql://nexus:nexuspassword@localhost:5432/srb_nexus

# Set to true if connecting to cloud DB with SSL required (e.g., Supabase / RDS)
DB_SSL=false